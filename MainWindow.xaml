<Window x:Class="BackupVerify.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup Verify" Width="1056" Height="704"
        MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#0B1118"
        Foreground="#EFF5F9" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#131D28" />
        <SolidColorBrush x:Key="Edge" Color="#2A3949" />
        <SolidColorBrush x:Key="Text" Color="#EFF5F9" />
        <SolidColorBrush x:Key="Muted" Color="#A7B8CA" />
        <SolidColorBrush x:Key="Accent" Color="#6DE6BA" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#1A2836"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".85"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BDEEDD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B241C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="19"/>
        </Style>
        <Style x:Key="Field" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#142231"/>
            <Setter Property="Background" Value="#E5EDF4"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Surface" Background="#0B1118">
        <Grid Margin="32,25,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,25">
                <Button DockPanel.Dock="Right" Content="Configuración" Click="OpenSettings" AutomationProperties.Name="Configuración"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="11" Background="#14392F" Margin="0,0,13,0">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Backup Verify" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border CornerRadius="6" Background="#233345" Margin="13,0,0,0" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="3-2-1" FontSize="12" FontWeight="SemiBold" Foreground="#CAD9E6"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <StackPanel x:Name="Dashboard">
                    <DockPanel Margin="0,0,0,13">
                        <ComboBox x:Name="Scope" DockPanel.Dock="Right" Width="176" Style="{StaticResource Field}" SelectionChanged="ScopeChanged" AutomationProperties.Name="Grupo"/>
                        <TextBlock Text="Verificación" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="Cards" Margin="-5,0,-5,17">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="5,0">
                                    <StackPanel>
                                        <Grid>
                                            <Border HorizontalAlignment="Left" Width="36" Height="36" CornerRadius="9" Background="#20354A">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#A8CDEF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="21" Margin="0,13,0,5"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Modo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,11"/>
                            <UniformGrid Columns="4" Margin="-4,0">
                                <Button x:Name="QuickButton" Content="Rápida" Tag="Quick" Margin="4,0" Click="SelectMode"/>
                                <Button x:Name="CompleteButton" Content="Completa" Tag="Complete" Margin="4,0" Click="SelectMode"/>
                                <Button x:Name="SelectedButton" Content="Archivos elegidos" Tag="Selected" Margin="4,0" Click="SelectMode"/>
                                <Button x:Name="RandomButton" Content="Aleatorio" Tag="Random" Margin="4,0" Click="SelectMode"/>
                            </UniformGrid>
                            <TextBlock x:Name="ModeHint" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,18,0,0">
                        <Button x:Name="VerifyButton" Content="Verificar" DockPanel.Dock="Right" MinWidth="118" Style="{StaticResource Primary}" Click="Verify"/>
                        <Button x:Name="CancelButton" Content="Cancelar" DockPanel.Dock="Right" Margin="0,0,9,0" Click="Cancel" Visibility="Collapsed"/>
                        <Button x:Name="DetailsButton" Content="Ver detalle" DockPanel.Dock="Left" Click="OpenDetails" Visibility="Collapsed"/>
                        <TextBlock x:Name="RunStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar x:Name="Activity" Height="3" Foreground="{StaticResource Accent}" Background="#243748" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="Details" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,13">
                        <Button Content="Volver" DockPanel.Dock="Right" Click="Back"/>
                        <Button x:Name="OutputButton" Content="Abrir carpeta" DockPanel.Dock="Right" Margin="0,0,8,0" Click="OpenOutput"/>
                        <TextBlock x:Name="DetailsTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="Sample" Grid.Row="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1">
                        <Grid>
                            <TextBlock x:Name="EmptyResult" Text="Sin diferencias" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                            <DataGrid x:Name="Findings" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"
                                      RowBackground="#131D28" AlternatingRowBackground="#172330" HeadersVisibility="Column"
                                      HorizontalGridLinesBrush="{StaticResource Edge}" GridLinesVisibility="Horizontal" RowHeight="34">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#203143"/><Setter Property="Foreground" Value="#CFDCE8"/>
                                        <Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Origen" Binding="{Binding Origin}" Width="100" MinWidth="100"/>
                                    <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="120" MinWidth="120"/>
                                    <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="*" MinWidth="220"/>
                                    <DataGridTextColumn Header="Resultado" Binding="{Binding Detail}" Width="2*" MinWidth="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel x:Name="Configuration" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,13">
                        <Button Content="Volver" DockPanel.Dock="Right" Click="Back"/>
                        <TextBlock Text="Configuración" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Disco USB" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="Drives" Width="260" Style="{StaticResource Field}" AutomationProperties.Name="Volúmenes NTFS"/>
                                <Button Content="Actualizar" Margin="8,0,0,0" Click="RefreshDrives"/>
                                <Button Content="Guardar" Margin="8,0,0,0" Style="{StaticResource Primary}" Click="SaveDrive"/>
                            </StackPanel>
                            <TextBlock x:Name="DriveStatus" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Abrir JSON" Click="OpenConfig"/>
                                <Button Content="Recargar" Margin="8,0,0,0" Click="ReloadConfig"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="config.json" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ConfigStatus" Margin="0,5,10,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="Footer" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
